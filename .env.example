# ─────────────────────────────────────────────────────────────────────────────
# HisaabKitaab - environment
# Copy to `.env.local` for local dev. On Vercel, add the same keys under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Where the app is reachable. Must match the Google OAuth redirect URI exactly.
APP_URL=http://localhost:3000

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── AI (Ollama Cloud) ────────────────────────────────────────────────────────
# Get a key at https://ollama.com/settings/keys
# Leave OLLAMA_HOST as-is for Ollama Cloud, or point it at a local daemon
# (http://127.0.0.1:11434) to run models on your own machine with no key.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# Model tiers. The defaults are cloud-hosted and known to handle tool calls well.
OLLAMA_CHAT_MODEL=gpt-oss:120b
OLLAMA_FAST_MODEL=gpt-oss:20b
OLLAMA_VISION_MODEL=gemma4:31b
OLLAMA_EXTRACT_MODEL=gemma4:31b

# ── Redis (Upstash) ──────────────────────────────────────────────────────────
# https://console.upstash.com → create database → REST API section.
# Without these the app runs on an in-process store: fine for a first look,
# but nothing survives a restart and nothing is shared between instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google OAuth + Drive ─────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: ${APP_URL}/api/auth/callback
# Scope used is drive.file - the app only ever sees files it created itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Developer login ──────────────────────────────────────────────────────────
# Username/password sign-in that skips OAuth, for testing.
# Set DEV_LOGIN_ENABLED=false on any deployment you don't want this on.
DEV_USERNAME=varad
DEV_PASSWORD=varad[123]
DEV_LOGIN_ENABLED=true

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_ROWS_PER_FILE=5000
MAX_COLUMNS_PER_FILE=32
MAX_ATTACHMENT_BYTES=15728640
