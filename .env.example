# ─────────────────────────────────────────────────────────────────────────────
# HisaabKitaab - environment
# Copy to `.env.local` for local dev. On Vercel, add the same keys under
# Project → Settings → Environment Variables.
#
# The short version of what you need to deploy:
#   required   SESSION_SECRET, DATABASE_URL
#   wanted     OLLAMA_API_KEY (the assistant), APP_URL
#   optional   GOOGLE_*, UPSTASH_*
# ─────────────────────────────────────────────────────────────────────────────

# Where the app is reachable. Must match the Google OAuth redirect URI exactly.
# On Vercel this can be left unset: the deployment URL is used instead. Set it
# once you have a custom domain, because Google needs a fixed redirect.
APP_URL=http://localhost:3000

# Signs the session cookie. Generate with: openssl rand -base64 32
# In production the app refuses to serve without this, because the fallback is
# published in this file and anyone holding it can mint a session for any account.
SESSION_SECRET=

# ── Account database (Postgres) - required in production ─────────────────────
# Every account gets its own storage here: folders, files, chat history and
# receipt bytes. Nobody needs a Google account to use the app.
#
# Any Postgres works. Free tiers that do:
#   Neon      https://neon.tech            0.5 GB   (also what Vercel Postgres is)
#   Supabase  https://supabase.com         0.5 GB
#   Railway   https://railway.app          trial credit
#
# Use the POOLED connection string, not the direct one - serverless functions
# open a connection per instance and a spike will exhaust a direct limit.
# Vercel's own Postgres integration injects POSTGRES_URL and is picked up too.
#
# Tables are created on first boot; there is no migration step to run.
DATABASE_URL=

# How much attachment storage one account may take. Raise it if your database
# has room, lower it if a free tier has to stretch across many people.
MAX_STORAGE_BYTES_PER_USER=536870912

# ── AI (Ollama Cloud) ────────────────────────────────────────────────────────
# Get a key at https://ollama.com/settings/keys
# Leave OLLAMA_HOST as-is for Ollama Cloud, or point it at a local daemon
# (http://127.0.0.1:11434) to run models on your own machine with no key.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# Model tiers. The defaults are cloud-hosted and known to handle tool calls well.
OLLAMA_CHAT_MODEL=gpt-oss:120b
OLLAMA_FAST_MODEL=gpt-oss:20b
OLLAMA_VISION_MODEL=gemma4:31b
OLLAMA_EXTRACT_MODEL=gemma4:31b

# ── Redis (Upstash) - optional ───────────────────────────────────────────────
# https://console.upstash.com → create database → REST API section.
# Purely a speed-up: caches, write locks and rate limiters move here, and the
# account data stays in Postgres. Everything works without it.
# Skip this entirely if you are only attaching one thing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google OAuth + Drive - optional ──────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: ${APP_URL}/api/auth/callback
#
# Two separate things, requested at two separate moments. Signing in asks for
# identity only. The drive.file scope is requested later, and only if a user
# chooses Drive as their storage - so most people never see that consent screen.
# drive.file means the app can only ever see files it created itself, which also
# keeps you out of Google's restricted-scope review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Developer login ──────────────────────────────────────────────────────────
# Username/password sign-in that skips OAuth, for testing. It grants the admin
# role, so in production it stays off unless DEV_LOGIN_ENABLED=true *and*
# DEV_PASSWORD has been changed from the value below. Locally it is on.
DEV_USERNAME=varad
DEV_PASSWORD=varad[123]
DEV_LOGIN_ENABLED=true

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_ROWS_PER_FILE=5000
MAX_COLUMNS_PER_FILE=32
MAX_ATTACHMENT_BYTES=15728640
